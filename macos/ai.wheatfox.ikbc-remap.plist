<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.wheatfox.ikbc-remap</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/wheatfox/Code/dotfiles/macos/ikbc-remap.sh</string>
    </array>
    <!-- 登录时应用一次 -->
    <key>RunAtLoad</key>
    <true/>
    <!-- 每 180s 重新断言一次：hidutil 映射在拔插 dongle / 唤醒后会丢，
         这里幂等地补回来，代价极小（一次瞬时的 hidutil set）。 -->
    <key>StartInterval</key>
    <integer>180</integer>
    <key>StandardErrorPath</key>
    <string>/tmp/ikbc-remap.err</string>
</dict>
</plist>
